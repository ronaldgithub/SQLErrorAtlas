<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLErrorAtlas.ViewModels"
             xmlns:views="using:SQLErrorAtlas.Views"
             xmlns:local="using:SQLErrorAtlas"
             x:Class="SQLErrorAtlas.Views.AnalyzeView"
             x:DataType="vm:AnalyzeViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBox Grid.Row="0" Name="LogBox"
                 Text="{Binding LogText}"
                 AcceptsReturn="True" AcceptsTab="False"
                 TextWrapping="NoWrap"
                 MinHeight="120" MaxHeight="220"
                 FontFamily="Consolas, Menlo, monospace" FontSize="12"
                 Watermark="Paste a chunk of the SQL Server ERRORLOG here…"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <Button Content="Analyze" Command="{Binding AnalyzeCommand}" IsDefault="True"/>
            <Button Content="Export analysis…" Command="{Binding ExportAnalysisCommand}"/>
            <Button Content="Clear" Command="{Binding ClearCommand}"/>
            <TextBlock Text="{Binding StatusText}" Classes="subtle" VerticalAlignment="Center"/>
        </StackPanel>

        <Expander Grid.Row="2" Header="Noteworthy lines (no error number)" Margin="0,0,0,8"
                  IsVisible="{Binding HasNotableLines}">
            <ItemsControl ItemsSource="{Binding NotableLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                             FontFamily="Consolas, Menlo, monospace" FontSize="12" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Grid Grid.Row="3" ColumnDefinitions="360,*" MinHeight="200">
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Bottom" Classes="subtle" Margin="0,6,0,0"
                           Text="Ranked by severity. Click an item for the guidance."/>
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AnalyzeHit">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,2">
                                <Border Grid.RowSpan="2" Classes="badge" Margin="0,0,8,0"
                                        Background="{Binding Urgency, Converter={x:Static local:Converters.UrgencyToBrush}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" Foreground="#111" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding SeverityText}" Foreground="#111" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Classes="subtle">
                                    <Run Text="{Binding KindText}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding OccurrenceText}"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <views:EntryDetailView Grid.Column="1" DataContext="{Binding Detail}"/>
        </Grid>
    </Grid>
</UserControl>
