<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLErrorAtlas.ViewModels"
             xmlns:views="using:SQLErrorAtlas.Views"
             x:Class="SQLErrorAtlas.Views.LookupView"
             x:DataType="vm:LookupViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <TextBox Text="{Binding NumberText}" Watermark="Error number" MinWidth="160"
                     VerticalAlignment="Center">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding LookupCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>
            <Button Content="Look up" Command="{Binding LookupCommand}" IsDefault="True"/>
            <TextBlock Text="{Binding Hint}" Classes="subtle" VerticalAlignment="Center"/>
        </StackPanel>

        <views:EntryDetailView DataContext="{Binding Detail}"/>
    </DockPanel>
</UserControl>
