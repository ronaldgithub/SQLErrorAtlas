<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLErrorAtlas.ViewModels"
             xmlns:local="using:SQLErrorAtlas"
             x:Class="SQLErrorAtlas.Views.EntryDetailView"
             x:DataType="vm:EntryDetailViewModel">

    <Panel>
        <TextBlock Text="Select an item to see the guidance."
                   Classes="subtle"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasGuidance}"/>

        <DockPanel IsVisible="{Binding HasGuidance}">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="badge" Background="{Binding Urgency, Converter={x:Static local:Converters.UrgencyToBrush}}">
                        <TextBlock Text="{Binding Urgency}" Foreground="#111" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{Binding HeaderText}" Classes="h1" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding SourceNote}" Classes="subtle" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="Copy as Markdown" Command="{Binding CopyMarkdownCommand}"/>
                <Button Content="Save as HTML…" Command="{Binding SaveHtmlCommand}"/>
                <Button Content="Open docs" Command="{Binding OpenDocsCommand}" IsVisible="{Binding HasDocsUrl}"/>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                <StackPanel Spacing="2">
                    <TextBlock Text="What it means" Classes="section"/>
                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap"/>

                    <TextBlock Text="Investigate" Classes="section"/>
                    <TextBlock Text="{Binding Investigate}" TextWrapping="Wrap"/>

                    <TextBlock Text="Fix" Classes="section"/>
                    <TextBlock Text="{Binding Fix}" TextWrapping="Wrap"/>

                    <StackPanel IsVisible="{Binding HasKeyTools}" Spacing="2">
                        <TextBlock Text="Key tools" Classes="section"/>
                        <TextBlock Text="{Binding KeyTools}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasDocsUrl}" Spacing="2">
                        <TextBlock Text="Reference" Classes="section"/>
                        <TextBlock Text="{Binding DocsUrl}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasRelatedIssues}" Spacing="4">
                        <TextBlock Text="Related deep-dive runbooks" Classes="section"/>
                        <ItemsControl ItemsSource="{Binding RelatedIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding $parent[ItemsControl].((vm:EntryDetailViewModel)DataContext).OpenIssueCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock>
                                            <Run Text="Issue"/>
                                            <Run Text="{Binding IssueId}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Title}"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
