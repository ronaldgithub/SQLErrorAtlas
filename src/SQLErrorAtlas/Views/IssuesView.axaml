<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SQLErrorAtlas.ViewModels"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:m="using:SQLErrorAtlas.Models"
             x:Class="SQLErrorAtlas.Views.IssuesView"
             x:DataType="vm:IssuesViewModel">

    <Grid ColumnDefinitions="260,*">
        <ListBox Grid.Column="0" Margin="0,0,10,0"
                 ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:IssueSummary">
                    <StackPanel Margin="0,3" Spacing="2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Classes="subtle" TextWrapping="Wrap">
                            <Run Text="{Binding Category}"/><Run Text=" · "/><Run Text="{Binding Status}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0" IsVisible="{Binding HasIssue}">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" Classes="h1"/>

                <Border Classes="card" IsVisible="{Binding HasSummary}">
                    <TextBlock Text="{Binding SummaryMd}" TextWrapping="Wrap"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:IssueSectionItem">
                            <StackPanel Spacing="2" Margin="0,6,0,0">
                                <TextBlock Text="{Binding Section}" Classes="section"/>
                                <md:MarkdownScrollViewer Markdown="{Binding ContentMd}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding HasDiagnostics}" Spacing="4" Margin="0,10,0,0">
                    <TextBlock Text="Diagnostic queries" Classes="section"/>
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:DiagnosticItem">
                                <Expander Margin="0,3" Header="{Binding Purpose}">
                                    <StackPanel Spacing="6">
                                        <Border Background="{DynamicResource CodeBackgroundBrush}" CornerRadius="4" Padding="8">
                                            <TextBlock Text="{Binding SqlText}" TextWrapping="Wrap"
                                                                 FontFamily="Consolas, Menlo, monospace" FontSize="12"/>
                                        </Border>
                                        <Button Content="Copy SQL" HorizontalAlignment="Left"
                                                Command="{Binding $parent[ItemsControl].((vm:IssuesViewModel)DataContext).CopyDiagnosticCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Column="1" Text="Select a runbook." Classes="subtle"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !HasIssue}"/>
    </Grid>
</UserControl>
